{
  "name": "@market-pulse/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Market Pulse backend: HTTP API, persistence, and application wiring.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
