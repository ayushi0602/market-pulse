    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@market-pulse/domain": "*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13"
  }
}
