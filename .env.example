# Copy to .env for local overrides. All values below are the defaults.

# HTTP port for the backend API.
PORT=4000

# Relational database connection.
# Step 1 uses SQLite through Node's built-in `node:sqlite` driver so the project
# runs with zero external services. The value is a filesystem path, or the
# special value ":memory:" (used by the test suite). Relative paths are
# resolved against the repository root, not the current working directory.
DATABASE_URL=./data/market-pulse.sqlite

NODE_ENV=development

# --- Market simulation -------------------------------------------------------
# Generated prices that keep the demo moving. There is no market data feed in
# this project; the simulator invents prices and runs every one of them through
# the same significance rule as the seed, so a generated event is an ordinary
# event. The API reports `source: "simulated"` and the UI repeats that word.
#
# Set to "off" to run on seeded data alone. The API then reports
# `source: "static"` and the UI stops claiming anything is updating.
MARKET_SIMULATION=on

# Milliseconds between generated observations. Minimum 250 -- anything faster
# fills the event log quicker than anyone can read it. Startup fails on a value
# below that rather than spinning.
MARKET_SIMULATION_INTERVAL_MS=3000
